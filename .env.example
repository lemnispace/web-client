# =============================================================================
# LemniSpace Web Client - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in the values

# -----------------------------------------------------------------------------
# Shop API Configuration (Primary Backend) - REQUIRED
# -----------------------------------------------------------------------------

# Shop-API base URL for server-side API calls
SHOP_API_URL=

# Shop-API base URL for client-side API calls (must be publicly accessible)
NEXT_PUBLIC_SHOP_API_URL=

# -----------------------------------------------------------------------------
# Text Mosaic Service - REQUIRED
# -----------------------------------------------------------------------------

# Text Mosaic API URL (txt-mosaic service)
NEXT_PUBLIC_TXT_MOSAIC_URL=

# -----------------------------------------------------------------------------
# Shopify Configuration (DEPRECATED)
# -----------------------------------------------------------------------------
# These variables are no longer used after migration to shop-api
# Kept for reference only

# LEMNISPACE_PRODUCTS_API_TOKEN=
# LEMNISPACE_PRODUCTS_ADMIN_API_TOKEN=
# LEMNISPACE_PRODUCTS_API_KEY=
# LEMNISPACE_PRODUCTS_API_SECRET_KEY=
# LEMNISPACE_STORE_DOMAIN=
# LEMNISPACE_HOST_NAME=
# LEMNISPACE_SHOP_NAME=

# -----------------------------------------------------------------------------
# Printful/Mockup Generation (OPTIONAL)
# -----------------------------------------------------------------------------

# LEMNISPACE_MOCKUP_GEN_API_URL=
# LEMNISPACE_MOCKUP_GEN_KEY=
