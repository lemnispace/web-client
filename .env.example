# =============================================================================
# LemniSpace Web Client Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Shop-API Configuration (Required for new backend)
# -----------------------------------------------------------------------------

# Shop-API base URL
# - Local development: http://localhost:8080
# - Staging: https://staging-api.lemnispace.com
# - Production: https://api.lemnispace.com
SHOP_API_URL=http://localhost:8080

# Shop-API Key (optional, for admin operations)
# Leave empty for local development
SHOP_API_KEY=

# -----------------------------------------------------------------------------
# Text Mosaic Service
# -----------------------------------------------------------------------------

# Text Mosaic API URL (txt-mosaic service)
TEXT_MOSAIC_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Shopify Configuration (Legacy - Can be removed after migration)
# -----------------------------------------------------------------------------

# Shopify store domain
LEMNISPACE_STORE_DOMAIN=http://lemnispace.com

# Shopify host configuration
LEMNISPACE_HOST_NAME=http://lemnispace.com
LEMNISPACE_HOST_SCHEME=http

# Shopify shop name
LEMNISPACE_SHOP_NAME=your-shop.myshopify.com

# Shopify API tokens
LEMNISPACE_PRODUCTS_API_TOKEN=your_storefront_access_token
LEMNISPACE_PRODUCTS_ADMIN_API_TOKEN=your_admin_api_token
LEMNISPACE_PRODUCTS_API_KEY=your_api_key
LEMNISPACE_PRODUCTS_API_SECRET_KEY=your_secret_key

# -----------------------------------------------------------------------------
# Printful/Mockup Generation
# -----------------------------------------------------------------------------

# Printful API configuration
LEMNISPACE_MOCKUP_GEN_API_URL=https://api.printful.com
LEMNISPACE_MOCKUP_GEN_KEY=your_printful_api_key

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------

# Node environment (development, production)
NODE_ENV=development
