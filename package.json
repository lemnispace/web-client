{
  "name": "lemnispace-web-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4001",
    "build": "next build",
    "start": "next start -p 4001",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "test:integration": "jest --testPathPattern=__integration__ --runInBand --no-cache",
    "test:integration:verbose": "jest --testPathPattern=__integration__ --runInBand --no-cache --verbose",
    "test:seed-data": "ts-node __integration__/seed-test-data.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "^2.0.0-alpha.4",
    "@heroicons/react": "^2.1.1",
    "@imgly/background-removal": "^1.3.0",
    "@shopify/shopify-api": "^10.0.0",
    "@shopify/storefront-api-client": "^0.3.3",
    "aws-sdk": "^2.1608.0",
    "fabric": "6.0.0-beta17",
    "isomorphic-dompurify": "^2.6.0",
    "next": "^14.2.5",
    "react": "^18",
    "react-dom": "^18",
    "react-easy-crop": "^5.0.6",
    "react-zoom-pan-pinch": "^3.4.4",
    "sharp": "^0.33.3",
    "uuid": "^10.0.0",
    "zod": "^3.22.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@headlessui/tailwindcss": "^0.2.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^14.0.4",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-fetch": "^2.7.0",
    "postcss": "^8",
    "prettier": "3.1.1",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
